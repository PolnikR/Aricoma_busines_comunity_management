{
  "application": {
    "name": "SampleAppRecovery2",
    "description": "Recovery of FinanceTBApp2",
    "environment": "dev",
    "platform": "VMware vCenter ESXi",
    "source_connection": "vcenter_default",
    "target_connection": "vcenter_default_destination",
    "tiers": {
      "database": {
        "order": 1,
        "description": "Database server group",
        "vms": [
          {
            "name": "TEST-DB01"
          },
          {
            "name": "TEST-DB02"
          }
        ]
      },
      "application": {
        "order": 3,
        "description": "Application server group",
        "vms": [
          {
            "name": "TEST-APP01"
          },
          {
            "name": "TEST-APP02"
          }
        ]
      },
      "web": {
        "order": 4,
        "description": "Web server group",
        "vms": [
          {
            "name": "TEST-WEB01"
          },
          {
            "name": "TEST-WEB02"
          }
        ]
      },
      "db_cluster": {
        "order": 2,
        "description": "DB Cluster Master Node",
        "vms": [
          {
            "name": "TEST-DB0_CLUSTER"
          }
        ]
      }
    }
  }
}